# TrafficFuse AI — environment template (safe to commit).
#
# Copy to a local, git-ignored .env and fill in real values there, or export the
# variables in your shell. NEVER commit credentials, kubeconfig contents,
# tokens or endpoints of any real system (AGENTS.md: keep configuration,
# credentials and runtime databases out of source control).

# Runtime profile: "local" (default) or "test". Phase 0 only supports these.
TRAFFICFUSE_ENV=local

# Local API bind (development only; bind to 127.0.0.1 by default).
TRAFFICFUSE_HOST=127.0.0.1
TRAFFICFUSE_PORT=8000

# --- Phase 1 failure-lab identity (standardized; see docs/PHASE1-PREFLIGHT.md) ---
# Only the disposable, TrafficFuse-owned cluster/context/namespace below may ever
# be used. Production Kubernetes clusters and the foreign clusters/contexts on
# this machine (incident-lab, pcp-dev, playground-crd, vmware-k8s, ...) are
# strictly out of scope. Any other value fails closed — never falls back to the
# ambient context.
TRAFFICFUSE_KIND_CLUSTER=trafficfuse-lab
TRAFFICFUSE_K8S_CONTEXT=kind-trafficfuse-lab
TRAFFICFUSE_NAMESPACE=trafficfuse-system

# Dedicated, git-ignored kubeconfig for all future cluster operations.
# The global ~/.kube/config is never used.
TRAFFICFUSE_KUBECONFIG_PATH=.runtime/kubeconfig/trafficfuse-lab.yaml

# Demo service ports (8000/8080/8081/8443 are free on the reference machine;
# 5000 is occupied and must never be reserved).
TRAFFICFUSE_LAB_PORT=8080

# Informational pin for the shared runtime. The installed distribution version
# is verified against the immutable Git commit by the test suite; do not edit.
AGENTIC_INTENT_GATE_VERSION=0.2.0

# --- Product mode (see docs/LIVE-DEMO-RUNBOOK.md) ---
# simulation (default): in-process lab, no Kubernetes involved.
# live: the approved disposable trafficfuse-lab Kind cluster only; requires
#       `uv run python -m trafficfuse.cli provision --profile live` once.
# replay: read-only recorded evidence (demo/replay/recorded-incident.json).
TRAFFICFUSE_MODE=simulation

# Local diagnosis model. Loopback endpoints only; nothing here selects
# credentials, execution identities, scopes or budgets.
TRAFFICFUSE_OLLAMA_URL=http://127.0.0.1:11434
TRAFFICFUSE_OLLAMA_MODEL=phi4-mini
